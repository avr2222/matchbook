# Copy this to scripts/.env (gitignored) and fill in your values.
# Get SUPABASE_URL from: Supabase dashboard -> Project Settings -> API -> Project URL
# Get SUPABASE_SERVICE_KEY from: Supabase dashboard -> Project Settings -> API -> service_role key
# NEVER commit scripts/.env to git.

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...
